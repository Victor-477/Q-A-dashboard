# TEACHER_PASSWORDS: passwords allowed to access the teacher page.
# There is NO password in the source code. Leave this unset and the server
# generates one on first run, stores it in the database and prints it at
# startup (it also appears in the dashboard's Activity Logs).
# Set it here to choose your own; use commas to allow more than one.
# TEACHER_PASSWORDS="choose-your-own,and-another"

# QA_SESSION_TTL_HOURS: how long a teacher stays logged in. Sessions survive a
# restart but expire after this many hours. Default: 12.
QA_SESSION_TTL_HOURS=12

# PORT: initial server port. If it is busy, the system tries the next ports.
PORT=3000

# HOST: use 0.0.0.0 to accept access from other devices on the network.
HOST="0.0.0.0"

# QA_TLS: "auto" (default) serves HTTPS with a self-signed certificate created
# on first run, so the teacher password is not readable on the network.
# Each device shows a one-time browser warning. Use "off" to serve plain HTTP.
QA_TLS=auto

# QA_DATA_DIR: folder holding the SQLite database and the TLS certificate.
# Defaults to ./data. The Electron dashboard sets this automatically.
QA_DATA_DIR="./data"

# QA_TRANSLATE_URL: address of a LibreTranslate-compatible server used to
# translate questions and answers. Leave it unset and translation is disabled:
# text is shown exactly as written and nothing leaves this machine.
# QA_TRANSLATE_URL="http://libretranslate.local:5000"
# QA_TRANSLATE_API_KEY=""

# ENABLE_AUTO_TRANSLATE: set to "false" to force translation off even when a
# provider is configured.
ENABLE_AUTO_TRANSLATE=true
